# Copy to .env (git-ignored) ONLY on the VPS. Do not commit real values.
# Use a READ-ONLY database role. Prefer putting the password in ~/.pgpass (chmod 600)
# instead of PGPASSWORD, so it never appears in this file.
# PGHOST=
# PGPORT=5432
# PGDATABASE=fedai
# PGUSER=
# PGSSLMODE=require          # prefer 在 node-pg 中等同 require，不会回退明文
# PGSSLROOTCERT=            # verify-full 时使用的 CA 证书（如阿里云 RDS CA）
# FEDAI_ALLOW_PLAINTEXT_DB= # 仅在负责人书面确认后设为 yes，且需 PGSSLMODE=disable
# FEDAI_SCHEMA=fedai_corpus
# FEDAI_DATA_MODE=auto        # auto | demo | postgres
# FEDAI_PORT=8787             # always bound to 127.0.0.1
# FEDAI_PROJECTIONS_TABLE=sep_projections
# AI Q&A (Ask AI page, docs/rag/说明.md). Without these the page says the Q&A is not configured.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# FEDAI_RAG_EMBED_MODEL=text-embedding-3-large   # Azure deployment name; vectors are shortened to 1536 dimensions
# FEDAI_RAG_CHAT_MODEL=gpt-4.1-mini              # Azure deployment name (gpt-4.1 has a 1 request/min quota)
# Only for server/scripts/embed.ts (writes rag_chunks); never the website's account:
# FEDAI_RAG_PGUSER=
# FEDAI_RAG_PGPASSWORD=
